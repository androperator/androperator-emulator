{
  "name": "@androperator/emulator",
  "version": "0.2.0",
  "description": "Android emulator lifecycle library and structured CLI extracted from Androperator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "androperator-emulator": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/test/",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/provenance.md",
    ".agents/skills/create-android-emulator/"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "release:pack": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.12.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/androperator/androperator-emulator.git"
  },
  "homepage": "https://github.com/androperator/androperator-emulator#readme",
  "bugs": "https://github.com/androperator/androperator-emulator/issues",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
